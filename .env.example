# Copy to .env (gitignored) or set as platform secrets. Never commit real values.

# "groq" (hosted, organiser-approved) or "local" (faster-whisper on CPU, nothing leaves the machine).
PROVIDER=groq

# Required for PROVIDER=groq. HOSTED_PROVIDER_APPROVED must be true for hosted calls to run.
GROQ_API_KEY=
HOSTED_PROVIDER_APPROVED=true

# Optional overrides
# LOG_LEVEL=INFO
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe

# Models used (Groq, open-source). These override config/config.yaml.
TRANSCRIBE_MODEL=whisper-large-v3
CONDENSE_MODEL=openai/gpt-oss-20b
# Extra models that summarise sections in parallel (each has its own per-minute allowance)
CONDENSE_PARALLEL_MODELS=openai/gpt-oss-120b
JUDGE_MODEL=openai/gpt-oss-120b
# Tried in order when a model's free-tier daily limit is reached (comma-separated)
CONDENSE_FALLBACK_MODELS=openai/gpt-oss-120b
JUDGE_FALLBACK_MODELS=openai/gpt-oss-20b
